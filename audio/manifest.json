 },
 "eca922dc": {
  "es": "Un momento, por favor",
  "en": "One moment, please"
 },
 "6cf0a2db": {
  "es": "¿Puedo pasar?",
  "en": "May I come in / get through?"
 },
 "d19cc9b9": {
