 },
 "fb10c7c4": {
  "es": "¿Está lejos de aquí?",
  "en": "Is it far from here?"
 },
 "3819e3d8": {
  "es": "Está a diez minutos andando",
  "en": "It's ten minutes on foot"
 },
 "440b2a0d": {
  "es": "Todo recto y luego a la izquierda",
  "en": "Straight ahead, then left"
 },
 "6b9714d3": {
